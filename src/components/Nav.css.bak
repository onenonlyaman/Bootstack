.nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: var(--z-nav);
  color: var(--ink);
  transition:
    transform 0.8s var(--ease-out),
    opacity 0.5s linear,
    color 0.4s linear;
  will-change: transform;
}

/* Entrance: hidden only while the loader is still up. Declared with the same
   specificity as .is-hidden and placed before it, so the retract still wins. */
.nav[data-state='out'] {
  transform: translate3d(0, -102%, 0);
  opacity: 0;
}

.nav.is-hidden { transform: translate3d(0, -102%, 0); }

.nav__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-3);
  .nav__bar {
  padding: clamp(0.8rem, 1.5vw, 1.2rem) var(--gutter);
}
  transition: padding 0.5s var(--ease-out);
}

.nav.is-stuck .nav__bar {
  padding-block: 0.85rem;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  background: color-mix(in srgb, var(--white) 72%, transparent);
}

.nav__brand {
  position: relative;
  z-index: 2;
}

/* ---- Links: label swaps upward on hover ---- */

.nav__links {
  display: none;
  gap: clamp(1.2rem, 2.4vw, 2.6rem);
}

.nav__link {
  position: relative;
  display: block;
  height: 1em;
  overflow: hidden;
  color: inherit;
  opacity: 0.72;
  transition: opacity 0.3s var(--ease-out);
}

.nav__link span {
  display: block;
  transition: transform 0.45s var(--ease-out);
}

.nav__link span + span {
  position: absolute;
  inset: 0;
  transform: translateY(100%);
  color: var(--blue);
}

.nav__link:hover { opacity: 1; }

/* The two spans must move to *different* places: the original leaves upward and
   the duplicate arrives at rest. Targeting `span` alone sent both of them up,
   which read as the label simply vanishing. */
.nav__link:hover span:first-child { transform: translateY(-100%); }
.nav__link:hover span + span { transform: translateY(0); }

.nav__actions {
  display: flex;
  align-items: center;
  gap: var(--s-2);
}

.nav__cta {
  display: none;
  padding: 0.7em 1.35em;
  border: 1px solid currentColor;
  border-radius: 999px;
  transition: background-color 0.35s var(--ease-out), color 0.35s var(--ease-out);
}

.nav__cta:hover {
  background: var(--yellow);
  border-color: var(--yellow);
  color: var(--ink);
}

/* ---- Toggle ---- */

.nav__toggle {
  position: relative;
  z-index: 2;
  display: grid;
  align-content: center;
  gap: 6px;
  width: 44px;
  height: 44px;
  padding: 0 8px;
  justify-items: end;
}

.nav__toggle i {
  display: block;
  width: 26px;
  height: 1.5px;
  background: currentColor;
  transition: transform 0.45s var(--ease-out), width 0.45s var(--ease-out);
}

.nav__toggle i:last-child { width: 18px; }
.nav__toggle:hover i:last-child { width: 26px; }

.nav__toggle.is-open i:first-child { transform: translateY(3.75px) rotate(45deg); }
.nav__toggle.is-open i:last-child { width: 26px; transform: translateY(-3.75px) rotate(-45deg); }

/* ---- Progress hairline ---- */

.nav__progress {
  height: 1.5px;
  background: color-mix(in srgb, currentColor 16%, transparent);
}

.nav__progress span {
  display: block;
  height: 100%;
  background: var(--blue);
  transform: scaleX(0);
  transform-origin: left center;
}

/* ---- Full-screen menu ---- */

.menu {
  position: fixed;
  inset: 0;
  z-index: 70;
  background: var(--mist);
  color: var(--ink);
  clip-path: inset(0 0 100% 0);
  transition: clip-path 0.75s var(--ease-in-out);
}

.menu.is-open { clip-path: inset(0 0 0 0); }

.menu__inner {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: var(--s-5);
  height: 100%;
  padding-block: clamp(6rem, 14vh, 9rem) clamp(2rem, 6vh, 4rem);
}

.menu__links {
  display: grid;
  gap: clamp(0.4rem, 1.4vh, 1rem);
}

.menu__links a {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  opacity: 0;
  transform: translateY(28px);
  transition:
    opacity 0.6s var(--ease-out),
    transform 0.6s var(--ease-out),
    color 0.3s linear;
  transition-delay: calc(var(--i) * 60ms + 120ms);
}

.menu.is-open .menu__links a {
  opacity: 1;
  transform: none;
}

.menu__links a:hover { color: var(--blue); }

.menu__index {
  color: var(--blue);
  font-size: 0.7rem;
}

.menu__foot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-2);
  padding-top: var(--s-3);
  border-top: 1px solid var(--rule);
}

.menu__mail {
  font-size: var(--t-md);
  color: var(--ink);
  border-bottom: 1px solid var(--blue);
  padding-bottom: 2px;
}

.menu__social {
  display: flex;
  gap: var(--s-3);
  color: var(--fg-soft);
}

.menu__social a:hover { color: var(--blue); }

@media (min-width: 1024px) {
  .nav__links { display: flex; }
  .nav__cta { display: inline-block; }
  .nav__toggle { display: none; }
}
