# Schedule a Call — server-side only.
# Copy this file to `.env` and put the real values there. `.env` is already in
# .gitignore, so it never leaves your machine.
#
# These names have NO `VITE_` prefix on purpose: Vite only exposes VITE_*
# variables to the browser bundle, so these stay server-side by construction.

# Hostinger SMTP. Port 465 is implicit TLS; use 587 for STARTTLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@thebootstack.io
SMTP_PASS=

# Where enquiries are delivered.
BOOTSTACK_CONTACT_EMAIL=info@thebootstack.io

# Optional. Must be the authenticated mailbox above, or the server will reject
# it as relaying. Defaults to "Bootstack <SMTP_USER>".
BOOTSTACK_FROM_EMAIL=
